<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PodpisPdf.OknoGlowne"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Korzen">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Własny pasek tytułu (treść okna sięga pod pasek, tło Mica). -->
        <Grid x:Name="PasekTytulu" Height="48" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image x:Name="IkonaTytulu" Width="18" Height="18" />
                <TextBlock x:Name="TytulOkna" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Frame x:Name="Ramka" Grid.Row="1" />
    </Grid>
</Window>
