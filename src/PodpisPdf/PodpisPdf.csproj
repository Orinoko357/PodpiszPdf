<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PodpisPdf</AssemblyName>
    <RootNamespace>PodpisPdf</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>PodpisPdf.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Product>PodpisPdf</Product>
    <Version>3.0.0.1</Version>
    <Description>Kwalifikowany podpis elektroniczny PAdES dla plików PDF</Description>

    <!-- Aplikacja bez pakietu MSIX, z własnym środowiskiem Windows App SDK (nie wymaga instalacji). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Wbudowany resources.pri w jednym pliku exe. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Własna metoda Main: jedna kopia programu i obsługa parametrów przed startem interfejsu. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- dotnet publish -c Release -r win-x64  →  jeden plik PodpisPdf.exe (przy pierwszym uruchomieniu wypakowuje pliki WinUI) -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="PodpisPdf.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Podpisany pakiet menu Windows 11 i jego certyfikat — tworzone w GitHub Actions (katalog pakiet/). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\pakiet\wynik\PodpisPdf.msix" LogicalName="PodpisPdf.msix" Condition="Exists('..\..\pakiet\wynik\PodpisPdf.msix')" />
    <EmbeddedResource Include="..\..\pakiet\wynik\PodpisPdf.cer" LogicalName="PodpisPdf.cer" Condition="Exists('..\..\pakiet\wynik\PodpisPdf.cer')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <!-- Moduły Windows App SDK, z których program nie korzysta (AI, uczenie maszynowe z onnxruntime/DirectML,
       widżety) — bez nich PodpisPdf.exe jest znacznie mniejszy. Pakiet zbiorczy zostaje (zależą od niego
       H.NotifyIcon i Community Toolkit), a bezpośrednie odwołanie z ExcludeAssets="all" wyłącza ich pliki. -->
  <ItemGroup Condition="'$(BezZbednychSkladnikow)' == 'true'">
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="1.8.79" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="1.8.2223" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="1.8.251231004" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PodpisPdf.Core\PodpisPdf.Core.csproj" />
  </ItemGroup>

</Project>
