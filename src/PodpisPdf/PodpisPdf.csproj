<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PodpisPdf</AssemblyName>
    <RootNamespace>PodpisPdf</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>PodpisPdf.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Product>PodpisPdf</Product>
    <Version>3.0.0.1</Version>
    <Description>Kwalifikowany podpis elektroniczny PAdES dla plików PDF</Description>

    <!-- Aplikacja bez pakietu MSIX, z własnym środowiskiem Windows App SDK (nie wymaga instalacji). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Wbudowany resources.pri w jednym pliku exe. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Własna metoda Main: jedna kopia programu i obsługa parametrów przed startem interfejsu. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- dotnet publish -c Release -r win-x64  →  jeden plik PodpisPdf.exe (przy pierwszym uruchomieniu wypakowuje pliki WinUI) -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Przycinanie częściowe: z bibliotek oznaczonych jako bezpieczne (m.in. projekcja Windows SDK, 53 MB)
         zostaje tylko używany kod; iText, BouncyCastle i kod programu zostają w całości. Pełny podpis
         próbny (tryb sprawdzania), zrzuty i test menu w GitHub Actions sprawdzają wynik. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Serwer COM menu Windows 11 (IExplorerCommand) i odczyt ustawień JSON przez odbicie. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="PodpisPdf.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Podpisany pakiet menu Windows 11 i jego certyfikat — tworzone w GitHub Actions (katalog pakiet/). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\pakiet\wynik\PodpisPdf.msix" LogicalName="PodpisPdf.msix" Condition="Exists('..\..\pakiet\wynik\PodpisPdf.msix')" />
    <EmbeddedResource Include="..\..\pakiet\wynik\PodpisPdf.cer" LogicalName="PodpisPdf.cer" Condition="Exists('..\..\pakiet\wynik\PodpisPdf.cer')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <!-- Moduły Windows App SDK, z których program nie korzysta: AI i uczenie maszynowe (onnxruntime, DirectML —
       ok. 40 MB), widżety. Pakiet zbiorczy Microsoft.WindowsAppSDK zostaje (zależą od niego H.NotifyIcon
       i Community Toolkit); pliki tych modułów wyłączamy z kopiowania do programu — zarówno z paczki MSIX
       środowiska (Microsoft.WindowsAppSDK.Runtime), jak i z pakietów składników. -->
  <Target Name="PomijajZbedneSkladnikiWindowsAppSdk"
          BeforeTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromMsix;AddMicrosoftWindowsAppSDKPayloadFilesFromComponents"
          DependsOnTargets="ExtractMicrosoftWindowsAppSDKMsixFiles">
    <ItemGroup>
      <_ZbedneSkladniki Include="onnxruntime*.dll;DirectML.dll;Microsoft.Windows.AI.*.dll;Microsoft.Windows.Widgets.dll;Microsoft.Windows.Workloads*.dll;workloads*.json" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\**\%(_ZbedneSkladniki.Identity)" Condition="'$(MicrosoftWindowsAppSDKMsixContent)' != ''" />
      <WindowsAppSdkComponentPackages Remove="@(WindowsAppSdkComponentPackages)"
        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', 'microsoft\.windowsappsdk\.(ai|ml|widgets)[\\/.]', System.Text.RegularExpressions.RegexOptions.IgnoreCase))" />
    </ItemGroup>
    <Message Importance="high" Text="Pominięte pliki Windows App SDK: @(MicrosoftWindowsAppSDKFilesExcluded->'%(Filename)%(Extension)', ', ')" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\PodpisPdf.Core\PodpisPdf.Core.csproj" />
  </ItemGroup>

</Project>
