<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PodpiszPdf.Mac.OknoPin"
        Title="PIN karty"
        Width="420" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24,20,24,18" Spacing="10">
    <TextBlock Text="Wpisz PIN karty" FontSize="16" FontWeight="SemiBold" />
    <TextBlock x:Name="Opis" TextWrapping="Wrap" />
    <Border x:Name="Ostrzezenie" IsVisible="False" CornerRadius="6" Padding="10,6" Background="#33D13438">
      <TextBlock x:Name="TekstOstrzezenia" TextWrapping="Wrap" />
    </Border>
    <TextBox x:Name="Pin" PasswordChar="●" Watermark="PIN" MaxLength="64" />
    <TextBlock Text="PIN trafia tylko do karty — program go nie zapisuje." Classes="drugi" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Content="Anuluj" MinWidth="96" HorizontalContentAlignment="Center" IsCancel="True" Click="PrzyAnulowaniu" />
      <Button x:Name="PrzyciskPodpisz" Content="Podpisz" MinWidth="96" HorizontalContentAlignment="Center" Classes="accent"
              IsDefault="True" Click="PrzyPodpisie" />
    </StackPanel>
  </StackPanel>
</Window>
