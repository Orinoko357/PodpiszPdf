<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PodpisPdf.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Biblioteka natywna PDFium (wywołania w DokumentPdf.Pdfium): pdfium.dll dla Windows (program)
         i libpdfium.so dla Linuksa (testy), kompilacje bblanchon/pdfium-binaries. -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="157.0.8086" />
    <PackageReference Include="bblanchon.PDFium.Linux" Version="157.0.8086" />
    <PackageReference Include="itext" Version="9.3.0" />
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.3.0" />
    <!-- iText 9.3 → Microsoft.Extensions.DependencyModel 1.1.0 ciągnie Newtonsoft.Json 9.0.1 (podatność
         GHSA-5crp-9r3c-p9vr) — wymuszamy wersję z poprawką. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Zasoby\LiberationSans-Regular.ttf" LogicalName="PodpisPdf.Core.LiberationSans-Regular.ttf" />
    <EmbeddedResource Include="Zasoby\LiberationSans-Bold.ttf" LogicalName="PodpisPdf.Core.LiberationSans-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PodpisPdf.Tests" />
  </ItemGroup>

</Project>
